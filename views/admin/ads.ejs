<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><link rel="stylesheet" href="/assets/style.css"><script src="/assets/app.js" defer></script></head><body><div class="app">
<div class="topbar"><a href="/ckmr/" class="icon-btn">←</a><h1 style="font-size:18px">Ads (24h status)</h1></div>
<form method="post" action="/ckmr/ads" enctype="multipart/form-data" style="padding:20px;background:var(--primary-soft);margin:14px;border-radius:10px">
<label style="font-size:12px;color:var(--muted)">Image or video</label>
<input type="file" name="media" accept="image/*,video/*" class="input" style="margin-bottom:10px">
<input class="input" name="title" placeholder="Title (shown under media)" style="margin-bottom:10px">
<input class="input" name="caption" placeholder="Caption / description" required style="margin-bottom:10px">
<button class="btn">Publish ad</button>
</form>
<% ads.forEach(function(a){ %>
<div style="padding:14px;border-bottom:1px solid var(--border)">
  <% if (a.video) { %><video src="<%= e(a.video) %>" controls style="max-width:100%;border-radius:8px"></video>
  <% } else if (a.image) { %><img src="<%= e(a.image) %>" style="max-width:100%;border-radius:8px"><% } %>
  <% if (a.title) { %><p style="font-weight:700;margin:6px 0 0"><%= e(a.title) %></p><% } %>
  <p style="margin:4px 0"><%= e(a.caption) %></p>
  <small>Expires: <%= a.expires_at %></small> · <a href="/ckmr/ads?del=<%= a.id %>" class="danger">Delete</a>
</div>
<% }); %>
</div></body></html>
