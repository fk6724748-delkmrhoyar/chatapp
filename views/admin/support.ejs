<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><link rel="stylesheet" href="/assets/style.css"><script src="/assets/app.js" defer></script></head><body><div class="app">
<div class="topbar"><a href="/ckmr/" class="icon-btn">←</a><h1 style="font-size:18px">Support tickets</h1></div>
<% rows.forEach(function(t){ %><div style="padding:14px;border-bottom:1px solid var(--border)"><strong><%= e(t.title) %></strong><br><small><%= e(t.email) %> · <%= e(t.status) %> · <%= t.created_at %></small><p style="margin-top:8px"><%- nl2brLinkify(t.description) %></p><% if (t.reply) { %><div style="background:var(--primary-soft);padding:10px;border-radius:8px;margin:8px 0"><strong>Reply:</strong><br><%- nl2brLinkify(t.reply) %></div><% } %><form method="post" action="/ckmr/support"><input type="hidden" name="id" value="<%= t.id %>"><textarea class="input" name="reply" placeholder="Reply to user" rows="3" required><%= e(t.reply) %></textarea><button class="btn" style="margin-top:8px">Send reply</button></form></div><% }); %>
</div></body></html>
