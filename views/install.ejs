<!doctype html>
<html><head><meta charset="utf-8"><title>CK Chat Installer</title>
<style>
body{font-family:system-ui;background:#f0f4ff;margin:0;padding:40px 20px}
.box{max-width:480px;margin:0 auto;background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(30,80,200,.1)}
h1{color:#1e6bff;margin-top:0}
label{display:block;margin:12px 0 4px;font-weight:600;color:#333}
input{width:100%;padding:10px;border:1px solid #cfd8ec;border-radius:8px;box-sizing:border-box}
button{margin-top:20px;width:100%;background:#1e6bff;color:#fff;border:0;padding:14px;border-radius:8px;font-size:16px;cursor:pointer}
.ok{background:#e6f7ec;color:#1a7f3c;padding:14px;border-radius:8px;margin-bottom:14px}
.err{background:#fde8e8;color:#b91c1c;padding:14px;border-radius:8px;margin-bottom:14px}
</style></head><body>
<div class="box">
<h1>CK Chat Installer</h1>
<% if (ok) { %>
  <div class="ok">Installation complete! <a href="/">Open App</a> | <a href="/ckmr/">Admin Panel</a><br><strong>Your settings are saved in config/config.json.</strong></div>
<% } %>
<% if (error) { %><div class="err">Error: <%= error %></div><% } %>
<form method="post">
  <h3>Database</h3>
  <label>MySQL Host</label><input name="host" value="localhost" required>
  <label>Database Name</label><input name="dbname" value="ckchat" required>
  <label>DB User</label><input name="user" value="root" required>
  <label>DB Password</label><input type="password" name="pass">
  <h3>Admin Account</h3>
  <label>Admin Username</label><input name="admin_user" value="admin" required>
  <label>Admin Email</label><input type="email" name="admin_email" required>
  <label>Admin Password</label><input type="password" name="admin_pass" required>
  <button>Install Now</button>
</form>
</div></body></html>
