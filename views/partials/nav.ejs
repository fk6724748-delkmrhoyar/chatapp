<style>
.nav-item{position:relative}
.nav-badge{position:absolute;top:2px;right:calc(50% - 22px);min-width:16px;height:16px;padding:0 4px;background:#dc2626;color:#fff;border-radius:8px;font-size:10px;font-weight:700;line-height:16px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.25)}
</style>
<div class="bottom-nav">
  <a class="nav-item <%= tab==='chats'?'active':'' %>" href="/chats"><span class="nav-icon">💬</span>Chats</a>
  <a class="nav-item <%= tab==='status'?'active':'' %>" href="/status"><span class="nav-icon">⊙</span>Updates</a>
  <a class="nav-item <%= tab==='channels'?'active':'' %>" href="/channels"><span class="nav-icon">📢</span>Channels</a>
  <a class="nav-item <%= tab==='calls'?'active':'' %>" href="/calls">
    <span class="nav-icon">📞</span>Calls
    <% if (typeof callBadge !== 'undefined' && callBadge > 0) { %><span class="nav-badge"><%= callBadge>99?'99+':callBadge %></span><% } %>
  </a>
</div>
<script>
(function(){
  if(!window.io || !window.CK_UID) return;
  window.ckSocket = window.ckSocket || io();
  window.ckSocket.emit('auth', window.CK_UID);
})();
</script>
