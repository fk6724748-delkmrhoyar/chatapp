<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><link rel="stylesheet" href="/assets/style.css"><script src="/assets/app.js" defer></script></head><body><div class="app">
<div class="topbar"><a href="/ckmr/" class="icon-btn">←</a><h1 style="font-size:18px">Verification requests</h1></div>
<% rows.forEach(function(r){ %><div style="padding:14px;border-bottom:1px solid var(--border)">
<strong><%= e(r.target_name) %></strong> (<%= r.target_type %>) — <em><%= r.status %></em><br>
Email: <%= e(r.email) %> · Method: <%= e(r.method) %> · TRX: <%= e(r.trx_id) %><br>
<% if (r.screenshot) { %><a href="/<%= e(r.screenshot) %>" target="_blank">View screenshot</a><br><% } %>
<% if (r.status === 'pending') { %>
<a href="/ckmr/requests?approve=<%= r.id %>" class="btn" style="display:inline-block;width:auto;padding:6px 14px;margin-right:6px;margin-top:8px">Approve</a>
<a href="/ckmr/requests?reject=<%= r.id %>" class="btn" style="display:inline-block;width:auto;padding:6px 14px;background:#dc2626">Reject</a>
<% } %>
</div><% }); %>
</div></body></html>
