<%- include('partials/head', { title: title }) %><div class="app">
<div class="topbar"><a href="/chats" class="icon-btn">←</a><h1 style="font-size:18px">Select contact</h1></div>
<form class="search" method="get"><span>🔍</span><input name="q" placeholder="Search username to find more" value="<%= e(q) %>" autofocus></form>
<a href="/group/new" class="chat-item" style="text-decoration:none;color:inherit"><div class="avatar">👥</div><div class="chat-meta"><div class="chat-name">New group</div></div></a>
<a href="/channel/new" class="chat-item" style="text-decoration:none;color:inherit"><div class="avatar">📢</div><div class="chat-meta"><div class="chat-name">New channel</div></div></a>
<div style="padding:10px 14px;color:var(--muted);font-size:12px"><%= q !== '' ? 'Results' : 'Contacts' %></div>
<% if (!users.length) { %><div class="empty">No users found</div><% } %>
<% users.forEach(function(u){ var init = (u.name || u.email || '?').charAt(0).toUpperCase(); %>
<a href="/chat/<%= u.id %>" class="chat-item" style="text-decoration:none;color:inherit">
  <div class="avatar"><% if (u.avatar) { %><img src="<%= e(u.avatar) %>"><% } else { %><%= init %><% } %></div>
  <div class="chat-meta"><div class="chat-name"><%= e(displayName(u)) %><% if (u.blue_tick) { %><%- blueTickHtml() %><% } %></div>
  <div class="chat-preview">@<%= e(u.username || ('user' + u.id)) %> · <%= e(u.email) %></div></div>
</a>
<% }); %>
<% if (q === '') { %><div style="padding:14px;color:var(--muted);font-size:12px;text-align:center">Search by username above to find more users</div><% } %>
</div></body></html>
